# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# User Identity
DEVTRACK_USER_NAME=Aditya07024
DEVTRACK_USER_EMAIL=adityakumar07024@gmail.com

# MongoDB Connection String (MongoDB Atlas or local instance)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/devtrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/devtrack

# Authentication Secret (min 32 characters for JWT signing)
AUTH_SECRET=devtrack-super-secret-key-change-in-production-min-32-chars
AUTH_URL=http://localhost:3000

# Push Notifications / VAPID (Generate via `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adityakumar07024@gmail.com

# Notification Scheduler Secret (Protects /api/cron/* endpoints)
CRON_SECRET=devtrack-cron-secret-key-12345

# Optional Email Notifications
RESEND_API_KEY=
EMAIL_FROM=adityakumar07024@gmail.com

# Optional Error Monitoring
SENTRY_DSN=

# Optional AI Features (future use)
OPENAI_API_KEY=
GEMINI_API_KEY=
